# PostgreSQL (matches docker-compose.yml)
POSTGRES_USER=offerly
POSTGRES_PASSWORD=offerly
POSTGRES_DB=offerly
DATABASE_URL="postgresql://offerly:offerly@localhost:5432/offerly?schema=public"

# Auth.js (generate AUTH_SECRET with: openssl rand -base64 32)
AUTH_SECRET=
# GitHub OAuth App credentials
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Optional: seed data for this existing user instead of the demo user (sign in once first)
# SEED_USER_EMAIL=you@example.com

# Optional: fill a new account with demo data on first sign-in (for a portfolio deployment)
# DEMO_DATA_ON_SIGNUP=true
